{
  "name": "IKNET firmware (ESP-IDF v5.5.6)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "espressif.esp-idf-extension",
        "espressif.esp-idf-web"
      ]
    }
  },
  "runArgs": ["--privileged"]
}
